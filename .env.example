# Required in production. Local development generates and stores a secret on first run.
CLOSINGDESK_SESSION_SECRET=

# Encrypts uploaded files and the matter database at rest. Required in production.
CLOSINGDESK_FILE_KEY=

# Attorney sign-in. In local development, unset uses vitaliy@closingdesk.local / harbor-pine.
CLOSINGDESK_ATTORNEY_EMAIL=vitaliy@closingdesk.local
CLOSINGDESK_ATTORNEY_NAME=Vitaliy
CLOSINGDESK_ATTORNEY_PASSWORD=

# Optional. Absolute path for encrypted files. Defaults to ./data
CLOSINGDESK_DATA_DIR=

# Optional. Delete stored documents this many days after upload.
CLOSINGDESK_RETENTION_DAYS=

# Optional. Server-side model used only to refine comparisons. Documents are never sent from the browser.
# Leave unset to use the built-in comparison, which does not call an external service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
